# Neighbr Backend Configuration

ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Database & Cache
DATABASE_URL=postgresql+asyncpg://neighbr:neighbr_password@localhost:5432/neighbr_db
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=neighbr_super_secret_jwt_key_change_in_production_32char
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / MinIO Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=neighbr-media

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# SMS
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
